# Default: no network calls to Agora. Restart the server after changes.
AGORA_LIVE_ENABLED=false
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# REST credentials are different from the App Certificate.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Alternative Conversational AI authorization, when supplied by your organizer.
AGORA_CONVO_TOKEN=
# Only needed for the corresponding product.
AGORA_CHAT_HOST=
AGORA_CHAT_ORG=
AGORA_CHAT_APP=
AGORA_CHAT_TOKEN=
AGORA_WHITEBOARD_TOKEN=
AGORA_WHITEBOARD_REGION=us-sv
AGORA_EDUCATION_TOKEN=
# Body secrets may be referenced as {{LAB_SECRET_LLM_KEY}} in request JSON.
# LAB_SECRET_LLM_KEY=
PORT=4317

# Rust coaching API. Passwords must be at least 12 characters with a letter and number.
COACH_BIND=127.0.0.1:4320
COACH_DATABASE_PATH=.artifacts/state/coach.sqlite3
COACH_AUDIO_ROOT=.artifacts/private/audio
COACH_SECURE_COOKIE=false
COACH_ALLOWED_ORIGIN=
COACH_PUBLIC_API_BASE_URL=
COACH_LEARNER_EMAIL=learner@example.test
COACH_LEARNER_PASSWORD=
COACH_ANNOTATOR_EMAIL=annotator@example.test
COACH_ANNOTATOR_PASSWORD=

# Optional Modal inference fallback; keep real proxy-auth credentials only in .env.
COACH_MODAL_ENABLED=false
COACH_MODAL_INFERENCE_URL=
COACH_MODAL_TOKEN_ID=
COACH_MODAL_TOKEN_SECRET=

# Experimental local worker settings; the MVP uses the interactive Colab notebook.
BUZZASR_MODEL_ID=BuzzASR/filipino
BUZZASR_MODEL_REVISION=fb8cf0d93e2437f8d639549c67733ca9db10e055
